# Serve organized HTML pages through the same clean public URLs.
#
# `site/<page>.html` is the canonical page — the file you edit. The matching
# `site/<page>/index.html` is a generated byte-identical alias; regenerate with
# `npm run sync:site` (scripts/sync-site.js).
/ /site/index.html 200
/studio /site/studio.html 200
/docs /site/docs.html 200
/pricing /site/pricing.html 200
/verifier /site/verifier.html 200
/legal/* /site/legal/:splat 200
/impressum /legal/impressum.html 200
/privacy /legal/privacy.html 200
/terms /legal/terms.html 200
/datenschutz /legal/privacy.html 200

